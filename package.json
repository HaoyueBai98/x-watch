{
  "name": "x-watch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Watch selected X accounts via the official filtered stream and email new posts.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:proxy": "NODE_USE_ENV_PROXY=1 HTTP_PROXY=http://127.0.0.1:7897 HTTPS_PROXY=http://127.0.0.1:7897 node src/index.js",
    "send:test-email": "node src/index.js --send-test-email",
    "send:test-email:proxy": "NODE_USE_ENV_PROXY=1 HTTP_PROXY=http://127.0.0.1:7897 HTTPS_PROXY=http://127.0.0.1:7897 node src/index.js --send-test-email",
    "check": "node src/index.js --check",
    "test": "node --test"
  },
  "dependencies": {
    "nodemailer": "^8.0.11"
  }
}
